// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  STUDENT
}

enum ViolationType {
  MINOR
  MODERATE
  HEAVY
}

enum LeaveType {
  WITHIN_CITY
  OUTSIDE_CITY
}

model User {
  id          String  @id @default(uuid())
  displayName String  @default("Santrib")
  avatar      String?

  username String    @unique
  password Password?
  type     Role      @default(STAFF)

  rewardRecords    RewardRecord[]
  violationRecords ViolationRecord[]
}

model Password {
  id       Int    @id @default(autoincrement())
  password String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@index([userId])
}

model StudentPassword {
  id       Int    @id @default(autoincrement())
  password String

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String  @unique

  @@index([studentId])
}

model Student {
  id             String  @id @default(uuid())
  fullName       String  @db.VarChar(75)
  identityNumber String  @db.VarChar(50)
  address        String?
  avatar         String?

  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId Int?

  dormitory   Dormitory? @relation(fields: [dormitoryId], references: [id], onDelete: SetNull)
  dormitoryId Int?

  violationPoints Int @default(0) @db.SmallInt
  rewardPoints    Int @default(0) @db.SmallInt
  totalPoints     Int @default(0) @db.SmallInt

  username String           @unique @db.VarChar(30)
  password StudentPassword?
  type     Role             @default(STUDENT)

  rewards    RewardRecord[]
  violations ViolationRecord[]
  leaves     LeaveRecord[]

  @@unique([fullName, identityNumber])
  @@index([fullName])
}

model Class {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(50) @unique

  students Student[]
}

model Dormitory {
  id      Int       @id @default(autoincrement())
  name    String    @db.VarChar(100) @unique
  address String?   @db.TinyText

  students Student[]
}

model RewardRecord {
  id          Int      @id @default(autoincrement())
  proof       String?  @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId Int

  reportedBy User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId String?

  @@index([reporterId])
  @@index([studentId])
  @@index([rewardId])
}

model ViolationRecord {
  id          Int      @id @default(autoincrement())
  proof       String?  @db.VarChar(255)
  description String?  @db.Text
  witness     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  violation   Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)
  violationId Int

  reportedBy User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId String?

  @@index([reporterId])
  @@index([studentId])
  @@index([violationId])
}

model ViolationCategory {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  violations Violation[]

  @@index([name])
}

model Violation {
  id     Int           @id @default(autoincrement())
  name   String        @db.VarChar(255)
  type   ViolationType
  points Int           @db.SmallInt

  records ViolationRecord[]

  category   ViolationCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int?

  @@index([name])
}

model RewardCategory {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  rewards Reward[]

  @@index([name])
}

model Reward {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(255)
  points Int    @db.SmallInt

  records RewardRecord[]

  category   RewardCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int?

  @@index([name])
}

model LeaveRecord {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  guardianName String    @db.VarChar(75)
  timeLimit    DateTime
  leaveDate    DateTime
  returnDate   DateTime
  leaveType    LeaveType
  destination  String?   @db.VarChar(50)

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  @@index([leaveType])
  @@index([leaveDate])
  @@index([returnDate])
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  loginTime DateTime @default(now())

  accountId       String
  accountUsername String
  accountName     String
  accountType     Role
}
