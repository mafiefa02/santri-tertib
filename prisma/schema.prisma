// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  STUDENT
}

enum ViolationType {
  MINOR
  MODERATE
  HEAVY
}

enum LeaveType {
  WITHIN_CITY
  OUTSIDE_CITY
}

model User {
  id          String  @id @default(uuid())
  displayName String  @default("Santrib")
  avatar      String?

  username String    @unique
  password Password?
  type     Role      @default(STAFF)

  RewardRecord    RewardRecord[]
  ViolationRecord ViolationRecord[]
}

model Password {
  id       String @id @unique
  password String

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
}

model StudentPassword {
  id       String @id @unique
  password String

  Student Student @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Student {
  id             String  @id @default(uuid())
  fullName       String  @db.VarChar(75)
  identityNumber String  @db.VarChar(50)
  avatar         String?
  totalPoints    Int     @default(0) @db.SmallInt

  username String           @unique @db.VarChar(30)
  password StudentPassword?
  type     Role             @default(STUDENT)

  RewardRecord    RewardRecord[]
  ViolationRecord ViolationRecord[]
  LeaveRecord     LeaveRecord[]

  @@unique([fullName, identityNumber])
  @@index([fullName])
}

model RewardRecord {
  id          Int      @id @default(autoincrement())
  proof       String?  @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId Int

  reportedBy User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String

  @@index([reporterId])
  @@index([studentId])
  @@index([rewardId])
}

model ViolationRecord {
  id          Int      @id @default(autoincrement())
  proof       String?  @db.VarChar(255)
  description String?  @db.Text
  witness     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  violation   Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)
  violationId Int

  reportedBy User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String

  @@index([reporterId])
  @@index([studentId])
  @@index([violationId])
}

model Violation {
  id     Int           @id @default(autoincrement())
  name   String        @db.VarChar(255)
  type   ViolationType
  points Int           @db.SmallInt

  ViolationRecord ViolationRecord[]

  @@index([name])
}

model Reward {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(255)
  points Int    @db.SmallInt

  RewardRecord RewardRecord[]

  @@index([name])
}

model LeaveRecord {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  guardianName String    @db.VarChar(75)
  timeLimit    DateTime
  leaveDate    DateTime
  returnDate   DateTime
  leaveType    LeaveType
  destination  String?   @db.VarChar(50)

  Student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  @@index([leaveType])
  @@index([leaveDate])
  @@index([returnDate])
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  loginTime DateTime @default(now())

  accountId       String
  accountUsername String
  accountName     String
  accountType     Role
}
